{
  "manifest_version": 3,
  "name": "Grabbit",
  "version": "1.1.0",
  "description": "Grab videos, streams, audio, images and fonts from the current page.",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "webRequest", "storage", "scripting", "activeTab", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "Grabbit", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}
}
